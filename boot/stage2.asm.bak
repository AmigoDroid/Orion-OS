
bits 16
org 0x8000

stage2_start:
    xor ax, ax
    mov ds, ax

    mov si, mensagem

.print:
    lodsb
    test al, al
    jz .halt

    mov ah, 0x0E
    int 0x10
    jmp .print

.halt:
    cli
.loop:
    hlt
    jmp .loop

mensagem db 'ORION: segundo estagio iniciado!', 13, 10, 0

times 1024 - ($ - $$) db 0
