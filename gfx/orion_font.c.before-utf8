#include "orion_font.h"

/*
 * Orion Font 0.1
 * Fonte bitmap propria do Orion OS.
 * Glifos desenhados manualmente em uma grade de 8x16.
 *
 * Cada byte representa uma linha:
 * bit 7 = pixel mais a esquerda.
 */

#define G(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p) \
    {a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p}

